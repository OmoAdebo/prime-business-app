# ============================================================
# Prime — Frontend environment (external Supabase project)
# ============================================================
# Copy to .env and fill in with values from your Supabase project:
#   Project Settings → API
#
# IMPORTANT: This project's backend is your OWN Supabase project
# (ref: zoukfdfpbmcyapkbujnr). Do NOT point these at the old
# Lovable Cloud project. Anything backend-related — tables,
# policies, functions, storage, secrets — must be managed in
# your Supabase dashboard and CLI, not in Lovable Cloud.
# ============================================================

VITE_SUPABASE_PROJECT_ID="zoukfdfpbmcyapkbujnr"
VITE_SUPABASE_URL="https://zoukfdfpbmcyapkbujnr.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<paste anon/publishable key from Supabase → Project Settings → API>"
